<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Shield logo / header -->
        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="56sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waymate"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@id/tv_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plan safer journeys. Monitor your trip."
            android:textSize="14sp"
            android:textColor="@color/on_surface_secondary"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp" />

        <!-- Resume trip card (hidden when no active trip) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resume_trip_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/purple_light"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_tagline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/resume_trip_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Active trip in progress – tap to resume"
                android:textColor="@color/purple_light"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Plan trip -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_plan_trip"
            style="@style/Widget.Waymate.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:text="@string/btn_plan_trip"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/resume_trip_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_directions" />

        <!-- Trusted contacts -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_contacts"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/btn_contacts"
            android:textColor="@color/purple_light"
            app:strokeColor="@color/purple_light"
            app:layout_constraintTop_toBottomOf="@id/btn_plan_trip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            app:cornerRadius="16dp" />

        <!-- SOS button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sos"
            style="@style/Widget.Waymate.SosButton"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:text="🆘  SOS"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btn_contacts"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            app:cornerRadius="16dp" />

        <TextView
            android:id="@+id/tv_disclaimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/safety_disclaimer"
            android:textSize="11sp"
            android:textColor="@color/on_surface_secondary"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/btn_sos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
