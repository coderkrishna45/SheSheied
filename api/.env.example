# Copy to api/.env. Never commit real credentials.
HOST=0.0.0.0
PORT=8787
DATABASE_PATH=./data/sheshield.sqlite
ORS_API_KEY=
# JSON file containing { incidents: [...], coverage: {...} }; fictional fixtures
# must never be used as live evidence.
INCIDENT_DATA_PATH=
# Audited stripped OSM map snapshot; never infer live crowds or lighting from it.
WALKING_DATA_PATH=
# Optional labelled synthetic conditions on real Salt Lake routes. Never crime data.
SALT_LAKE_CONDITION_PREVIEW=false
# Exact external HTTPS URL of the API tunnel (no trailing slash).
PUBLIC_BASE_URL=
N8N_WEBHOOK_URL=https://alluvia.app.n8n.cloud/webhook/sheshield-delivery
# Optional management access for inspecting/updating the existing n8n Cloud workflow.
# This is not used by the phone or for ordinary delivery jobs.
N8N_API_KEY=
# Random shared secret, also set in the n8n Header Auth credential.
WORKER_TOKEN=
# Only needed on API for callback signature validation.
TWILIO_AUTH_TOKEN=
# Optional local account inspection and Cloud import preparation; starts with AC.
TWILIO_ACCOUNT_SID=
# Used to prepare the n8n Cloud import. Sender numbers belong to Twilio.
TWILIO_FROM_NUMBER=
# Leave blank to use the voice sender for SMS as well.
TWILIO_SMS_FROM_NUMBER=
# Required for real calls; comma-separated recipients approved for testing.
LIVE_ALERTS_ENABLED=false
# Optional cloud SMS alongside sequential calls; requires the updated n8n worker.
LIVE_SMS_ENABLED=false
TEST_RECIPIENT_ALLOWLIST=
# Optional read-only Twilio trial recipient refresh. Verified recipients are enabled
# automatically; paid accounts continue to use the explicit allowlist above.
TRIAL_SYNC_VERIFIED_RECIPIENTS=false
# Optional enrollment code. Required if enrolling through a public tunnel.
ENROLLMENT_CODE=
# Optional incident metadata export from an existing Pinecone serverless index.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=
INCIDENT_SOURCE=
INCIDENT_LICENSE=
# west,south,east,north; describe the actual source coverage, not arbitrary bounds.
INCIDENT_COVERAGE_BOUNDS=
INCIDENT_RECORDS_VERIFIED=false
